# Copy to .env and edit. Never commit the real .env.
PORT=3210

# Postgres connection string, e.g. from Neon, Supabase or Vercel Postgres.
DATABASE_URL=postgresql://user:<REDACTED>@host/dbname?sslmode=require

# A throwaway database for `npm test` — its tables are truncated on every run.
TEST_DATABASE_URL=postgresql://postgres@127.0.0.1:5432/carrenter_test

# Signing key for session cookies. Generate with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET=<REDACTED>

# Credentials for the first admin account, used by `npm run seed` only.
SEED_ADMIN_EMAIL=admin@example.com
SEED_ADMIN_PASSWORD=<REDACTED>
SEED_ADMIN_NAME=Fleet Admin

# Rental company details printed on contracts
COMPANY_NAME=Car Renter
COMPANY_ADDRESS=123 King Fahd Road, Riyadh
COMPANY_PHONE=+966 11 000 0000
COMPANY_EMAIL=bookings@example.com
COMPANY_REG_NO=0000000000

# Money / policy defaults
CURRENCY=SAR
FUEL_CHARGE_PER_EIGHTH=25
LATE_DAY_MULTIPLIER=1.25
