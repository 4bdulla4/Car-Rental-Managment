# Copy to .env and edit. Never commit the real .env.
PORT=3210

# Turso (libSQL). A local file for development, libsql://... when hosted.
DATABASE_URL=file:./data/car-renter.db
# Required only for a hosted Turso database.
DATABASE_AUTH_TOKEN=<REDACTED>

# Signing key for session cookies. Generate with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET=<REDACTED>

# Credentials for the first admin account, used by `npm run seed` only.
SEED_ADMIN_EMAIL=admin@example.com
SEED_ADMIN_PASSWORD=<REDACTED>
SEED_ADMIN_NAME=Fleet Admin

# Rental company details printed on contracts
COMPANY_NAME=Car Rental
COMPANY_ADDRESS=123 King Fahd Road, Riyadh
COMPANY_PHONE=+966 11 000 0000
COMPANY_EMAIL=bookings@example.com
COMPANY_REG_NO=0000000000
COMPANY_VAT_NO=
COMPANY_WEBSITE=
COMPANY_BANK=

# Money / policy defaults
# Email (optional). Without these the app still produces a signing link to send
# by any other means. Get a key at resend.com and verify your sending domain.
RESEND_API_KEY=<REDACTED>
MAIL_FROM=Car Rental <noreply@yourdomain.com>
# The public address of this deployment, used for links inside email.
APP_URL=https://your-app.vercel.app

CURRENCY=SAR
FUEL_CHARGE_PER_EIGHTH=25
LATE_DAY_MULTIPLIER=1.25
