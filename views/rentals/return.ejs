<%- include('../partials/head') %>
<%- include('../partials/nav') %>

<div class="page-head">
  <div>
    <h1>Return <span class="mono"><%= rental.contract_no %></span></h1>
    <p class="sub"><%= rental.plate %> · <%= rental.make %> <%= rental.model %> · <%= rental.full_name %></p>
  </div>
  <a class="btn" href="/rentals/<%= rental.id %>">Back to contract</a>
</div>
<%- include('../partials/errors') %>

<form method="post" action="/rentals/<%= rental.id %>/return" id="returnForm">
  <input type="hidden" name="_csrf" value="<%= csrfToken %>">
  <div class="grid cols-2">
    <div class="card">
      <h3>Check-in</h3>
      <div class="row">
        <div class="field"><label for="return_date">Return date *</label><input id="return_date" name="return_date" type="date" value="<%= form.returnDate %>" required></div>
        <div class="field">
          <label for="return_odometer">Odometer (km) *</label>
          <input id="return_odometer" name="return_odometer" type="number" min="<%= rental.pickup_odometer %>" value="<%= form.returnOdometer %>" required>
          <div class="hint">Out at <%= rental.pickup_odometer.toLocaleString('en-US') %> km</div>
        </div>
        <div class="field">
          <label for="return_fuel">Fuel level *</label>
          <select id="return_fuel" name="return_fuel">
            <% FUEL_LABELS.forEach(function (lbl, i) { %>
              <option value="<%= i %>" <%= Number(form.returnFuel) === i ? 'selected' : '' %>><%= lbl %></option>
            <% }); %>
          </select>
          <div class="hint">Out at <%= fuelLabel(rental.pickup_fuel) %></div>
        </div>
      </div>
      <div class="row">
        <div class="field"><label for="damage_charge">Damage charge (<%= currency %>)</label><input id="damage_charge" name="damage_charge" type="number" step="0.01" min="0" value="<%= form.damageCharge %>"></div>
        <div class="field"><label for="other_charges">Other charges (<%= currency %>)</label><input id="other_charges" name="other_charges" type="number" step="0.01" min="0" value="<%= form.otherCharges %>"></div>
      </div>
      <div class="field"><label for="return_notes">Return notes / new damage</label><textarea id="return_notes" name="return_notes"><%= form.returnNotes || '' %></textarea></div>
    </div>

    <div class="card">
      <h3>Settlement (calculated)</h3>
      <div class="lines" id="settlement">
        <div class="line"><span>Rental charge · <span data-s="contractedDays"></span> day(s)</span><span data-s="baseCharge"></span></div>
        <div class="line"><span>Late return · <span data-s="lateDays"></span> day(s) @ <%= policy.lateDayMultiplier %>×</span><span data-s="lateFee"></span></div>
        <div class="line"><span>Excess km · <span data-s="excessKm"></span> km</span><span data-s="excessKmFee"></span></div>
        <div class="line"><span>Missing fuel · <span data-s="fuelMissingEighths"></span>/8 @ <%= money(policy.fuelChargePerEighth) %></span><span data-s="fuelFee"></span></div>
        <div class="line"><span>Damage</span><span data-s="damageCharge"></span></div>
        <div class="line"><span>Other charges</span><span data-s="otherCharges"></span></div>
        <div class="line"><span>Discount</span><span data-s="discount"></span></div>
        <div class="line total"><span>Total</span><span class="amount" data-s="total"></span></div>
        <div class="line"><span>Deposit held</span><span data-s="deposit"></span></div>
        <div class="line total"><span data-s="balanceLabel">Balance due</span><span class="amount" data-s="balanceDue"></span></div>
      </div>
      <p class="hint">Distance driven: <span class="mono" data-s="kmDriven"></span> km of <span class="mono" data-s="kmAllowed"></span> km included.</p>
    </div>
  </div>

  <div class="actions" style="margin-top:16px">
    <button class="btn primary" type="submit">Close contract &amp; print return sheet</button>
    <a class="btn" href="/rentals/<%= rental.id %>">Cancel</a>
  </div>
</form>

<script>
  var RENTAL = <%- JSON.stringify({
    start_date: rental.start_date, end_date: rental.end_date, daily_rate: rental.daily_rate,
    km_allowance_per_day: rental.km_allowance_per_day, excess_km_rate: rental.excess_km_rate,
    pickup_odometer: rental.pickup_odometer, pickup_fuel: rental.pickup_fuel,
    deposit: rental.deposit, discount: rental.discount
  }).replace(/</g, '\\u003c') %>;
  var POLICY = <%- JSON.stringify({ fuelChargePerEighth: policy.fuelChargePerEighth, lateDayMultiplier: policy.lateDayMultiplier }) %>;
  var CURRENCY = <%- JSON.stringify(currency) %>;
  var f = document.getElementById('returnForm');

  var r2 = function (n) { return Math.round((n + Number.EPSILON) * 100) / 100; };
  var fmt = function (n) { return r2(n).toFixed(2) + ' ' + CURRENCY; };
  function daysBetween(a, b) {
    var s = Date.parse(a), e = Date.parse(b);
    if (isNaN(s) || isNaN(e)) return 0;
    return Math.max(1, Math.round((e - s) / 86400000));
  }

  // Mirrors src/lib/pricing.js settlement(); the server value is authoritative.
  function compute() {
    var contractedDays = daysBetween(RENTAL.start_date, RENTAL.end_date);
    var actualDays = daysBetween(RENTAL.start_date, f.return_date.value);
    var lateDays = Math.max(0, actualDays - contractedDays);
    var lateFee = r2(lateDays * RENTAL.daily_rate * POLICY.lateDayMultiplier);
    var kmDriven = Math.max(0, (Number(f.return_odometer.value) || 0) - RENTAL.pickup_odometer);
    var kmAllowed = RENTAL.km_allowance_per_day * contractedDays;
    var excessKm = kmAllowed > 0 ? Math.max(0, kmDriven - kmAllowed) : 0;
    var excessKmFee = r2(excessKm * RENTAL.excess_km_rate);
    var fuelMissing = Math.max(0, RENTAL.pickup_fuel - (Number(f.return_fuel.value) || 0));
    var fuelFee = r2(fuelMissing * POLICY.fuelChargePerEighth);
    var baseCharge = r2(contractedDays * RENTAL.daily_rate);
    var damage = Number(f.damage_charge.value) || 0;
    var other = Number(f.other_charges.value) || 0;
    var total = r2(baseCharge + lateFee + excessKmFee + fuelFee + damage + other - RENTAL.discount);
    return {
      contractedDays: contractedDays, lateDays: lateDays, lateFee: lateFee,
      kmDriven: kmDriven, kmAllowed: kmAllowed, excessKm: excessKm, excessKmFee: excessKmFee,
      fuelMissingEighths: fuelMissing, fuelFee: fuelFee, baseCharge: baseCharge,
      damageCharge: damage, otherCharges: other, discount: RENTAL.discount,
      deposit: RENTAL.deposit, total: total, balanceDue: r2(total - RENTAL.deposit)
    };
  }

  var MONEY_KEYS = ['baseCharge','lateFee','excessKmFee','fuelFee','damageCharge','otherCharges','discount','total','deposit'];
  function render() {
    var s = compute();
    Object.keys(s).forEach(function (k) {
      var el = document.querySelector('[data-s="' + k + '"]');
      if (el) el.textContent = MONEY_KEYS.indexOf(k) >= 0 ? fmt(s[k]) : s[k];
    });
    document.querySelector('[data-s="balanceLabel"]').textContent =
      s.balanceDue >= 0 ? 'Balance due from customer' : 'Refund to customer';
    document.querySelector('[data-s="balanceDue"]').textContent = fmt(Math.abs(s.balanceDue));
  }

  ['return_date','return_odometer','return_fuel','damage_charge','other_charges'].forEach(function (n) {
    f[n].addEventListener('input', render);
    f[n].addEventListener('change', render);
  });
  render();
</script>
<%- include('../partials/foot') %>
