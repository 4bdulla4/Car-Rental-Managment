<%- include('../partials/head') %>
<%- include('../partials/nav') %>

<div class="page-head">
  <div>
    <h1 class="mono"><%= rental.contract_no %></h1>
    <p class="sub">
      <span class="badge <%= rental.status %>"><%= rental.status %></span>
      <% if (rental.status === 'active' && rental.end_date < today) { %><span class="badge overdue">Overdue</span><% } %>
      Issued <%= rental.created_at %><% if (rental.issued_by) { %> by <%= rental.issued_by %><% } %>
    </p>
  </div>
  <div class="actions">
    <a class="btn primary" href="/rentals/<%= rental.id %>/contract">Handover contract</a>
    <% if (rental.status === 'active' && !rental.signature_data) { %>
    <form method="post" action="/rentals/<%= rental.id %>/send">
      <input type="hidden" name="_csrf" value="<%= csrfToken %>">
      <button class="btn" type="submit">
        <svg viewBox="0 0 24 24"><rect x="3" y="5" width="18" height="14" rx="2.5"/><path d="M3.5 7l8.5 6 8.5-6"/></svg>
        <span><%= mailReady ? 'Email to sign' : 'Get signing link' %></span>
      </button>
    </form>
    <% } %>
    <% if (rental.status === 'active') { %><a class="btn" href="/rentals/<%= rental.id %>/return">Record return</a><% } %>
    <% if (rental.status === 'closed') { %><a class="btn" href="/rentals/<%= rental.id %>/receipt">Return sheet</a><% } %>
  </div>
</div>

<div class="grid cols-2">
  <div class="card">
    <h3>Vehicle</h3>
    <dl class="kv">
      <dt>Plate</dt><dd class="mono"><%= rental.plate %></dd>
      <dt>Vehicle</dt><dd><%= rental.make %> <%= rental.model %> <%= rental.year || '' %></dd>
      <dt>Colour</dt><dd><%= rental.color || '—' %></dd>
      <dt>VIN</dt><dd class="mono small"><%= rental.vin || '—' %></dd>
      <dt>Out at</dt><dd class="mono"><%= rental.pickup_odometer.toLocaleString('en-US') %> km · <%= fuelLabel(rental.pickup_fuel) %></dd>
      <% if (rental.status === 'closed') { %>
      <dt>Back at</dt><dd class="mono"><%= Number(rental.return_odometer).toLocaleString('en-US') %> km · <%= fuelLabel(rental.return_fuel) %></dd>
      <% } %>
    </dl>
    <% if (rental.pickup_notes) { %><p class="small muted" style="margin-top:12px"><strong>Condition at handover:</strong> <%= rental.pickup_notes %></p><% } %>
  </div>

  <div class="card">
    <h3>Customer</h3>
    <dl class="kv">
      <dt>Name</dt><dd><%= rental.full_name %></dd>
      <dt>Phone</dt><dd class="mono"><%= rental.phone %></dd>
      <dt>Email</dt><dd><%= rental.email || '—' %></dd>
      <dt>ID number</dt><dd class="mono small"><%= rental.id_number || '—' %></dd>
      <dt>Licence</dt><dd class="mono small"><%= rental.license_number || '—' %><%= rental.license_expiry ? ' · exp ' + rental.license_expiry : '' %></dd>
      <dt>Address</dt><dd><%= rental.address || '—' %></dd>
    </dl>
  </div>
</div>

<div class="card">
  <h3>Signature</h3>
  <% if (rental.signature_data) { %>
    <div class="signed-row">
      <img class="signature-shot" src="<%= rental.signature_data %>" alt="Signature">
      <div>
        <strong><%= rental.signed_name %></strong>
        <div class="sub">
          Signed electronically on <%= rental.handover_signed_at %> UTC<%= rental.signed_ip ? ' · ' + rental.signed_ip : '' %>
        </div>
      </div>
    </div>

    <div class="integrity <%= integrity.state %>">
      <% if (integrity.state === 'intact') { %>
        <strong>Agreement unchanged since signing.</strong>
        Fingerprint <span class="mono"><%= fingerprint %></span>.
      <% } else if (integrity.state === 'altered') { %>
        <strong>The agreement has changed since it was signed.</strong>
        The signature covers the original terms only — reissue and have it signed again.
      <% } else { %>
        <strong>No fingerprint recorded.</strong>
        This was signed before fingerprints were kept, so no comparison can be made.
      <% } %>
    </div>

    <% if (trail.length) { %>
      <h3 style="margin-top:22px">Audit trail</h3>
      <table class="trail-table">
        <% trail.forEach(function (e) { %>
          <tr>
            <td class="mono"><%= e.at %></td>
            <td><%= e.what %></td>
            <td class="mono muted"><%= e.detail %></td>
          </tr>
        <% }); %>
      </table>
    <% } %>

    <div class="actions" style="margin-top:16px">
      <a class="btn" href="/rentals/<%= rental.id %>/certificate">
        <svg viewBox="0 0 24 24"><path d="M14 3H7a2 2 0 0 0-2 2v14a2 2 0 0 0 2 2h10a2 2 0 0 0 2-2V8z"/><path d="M14 3v5h5"/><path d="M9 14.5l1.8 1.8 3.7-4"/></svg>
        <span>Certificate of completion</span>
      </a>
    </div>
  <% } else { %>
    <p class="small muted">Not signed yet.</p>
    <% if (signUrl) { %>
      <% if (linkExpired) { %>
        <div class="alert error" style="margin-top:12px">
          <svg viewBox="0 0 24 24"><circle cx="12" cy="12" r="9"/><path d="M12 8v5M12 16.2v.1"/></svg>
          <div>This link expired on <%= String(rental.sign_expires_at).slice(0, 10) %>. Issue a new one below.</div>
        </div>
      <% } %>

      <div class="field" style="margin-top:12px">
        <label for="signlink">Signing link</label>
        <input id="signlink" value="<%= signUrl %>" readonly onclick="this.select()">
        <div class="hint">
          <%= rental.sent_at ? 'Emailed to ' + rental.sent_to + ' on ' + rental.sent_at + ' UTC.' : 'Send this to the customer, or use the button above.' %>
          <%= rental.sign_expires_at ? 'Expires ' + String(rental.sign_expires_at).slice(0, 10) + '.' : '' %>
        </div>
      </div>

      <% if (signing.codeRequired && rental.sign_code) { %>
        <div class="field">
          <label for="signcode">Access code — read this out, do not email it</label>
          <input id="signcode" class="code-field" value="<%= rental.sign_code %>" readonly onclick="this.select()">
          <div class="hint">
            The customer needs this to open the agreement. Keeping it out of the email is
            what stops a forwarded message being enough to sign.
            <% if (Number(rental.sign_code_tries) > 0) { %>
              <strong><%= rental.sign_code_tries %> failed attempt<%= Number(rental.sign_code_tries) === 1 ? '' : 's' %> so far.</strong>
            <% } %>
          </div>
        </div>
      <% } %>

      <% if (rental.sign_opened_at) { %>
        <p class="hint">Opened by the customer on <%= rental.sign_opened_at %> UTC<%= rental.sign_opened_ip ? ' from ' + rental.sign_opened_ip : '' %>.</p>
      <% } %>

      <form method="post" action="/rentals/<%= rental.id %>/reissue" style="margin-top:14px">
        <input type="hidden" name="_csrf" value="<%= csrfToken %>">
        <button class="btn sm" type="submit">Issue a new link and code</button>
        <span class="hint" style="margin-left:8px">The current link stops working.</span>
      </form>
    <% } else { %>
      <p class="hint">Use the button above to create a link the customer can sign on their phone.</p>
    <% } %>
  <% } %>
</div>

<div class="card">
  <h3>Contract terms</h3>
  <dl class="kv">
    <dt>Period</dt><dd class="mono"><%= rental.start_date %> → <%= rental.end_date %> (<%= quote.days %> day<%= quote.days === 1 ? '' : 's' %>)</dd>
    <dt>Daily rate</dt><dd class="mono"><%= money(rental.daily_rate) %></dd>
    <dt>Mileage</dt><dd class="mono"><%= rental.km_allowance_per_day ? rental.km_allowance_per_day + ' km/day, then ' + money(rental.excess_km_rate) + '/km' : 'Unlimited' %></dd>
    <dt>Deposit</dt><dd class="mono"><%= money(rental.deposit) %></dd>
    <dt>Handover signed</dt><dd class="mono"><%= rental.handover_signed_at || 'Not recorded' %></dd>
  </dl>

  <div class="lines" style="margin-top:16px">
    <% if (rental.status === 'closed') { %>
      <div class="line"><span>Rental charge</span><span><%= money(rental.base_charge) %></span></div>
      <% if (rental.late_fee > 0) { %><div class="line"><span>Late return</span><span><%= money(rental.late_fee) %></span></div><% } %>
      <% if (rental.excess_km_fee > 0) { %><div class="line"><span>Excess kilometres</span><span><%= money(rental.excess_km_fee) %></span></div><% } %>
      <% if (rental.fuel_fee > 0) { %><div class="line"><span>Missing fuel</span><span><%= money(rental.fuel_fee) %></span></div><% } %>
      <% if (rental.damage_charge > 0) { %><div class="line"><span>Damage</span><span><%= money(rental.damage_charge) %></span></div><% } %>
      <% if (rental.other_charges > 0) { %><div class="line"><span>Other charges</span><span><%= money(rental.other_charges) %></span></div><% } %>
      <% if (rental.discount > 0) { %><div class="line"><span>Discount</span><span>-<%= money(rental.discount) %></span></div><% } %>
      <div class="line total"><span>Total</span><span class="amount"><%= money(rental.total_amount) %></span></div>
      <div class="line"><span>Deposit held</span><span>-<%= money(rental.deposit) %></span></div>
      <div class="line total"><span><%= rental.balance_due >= 0 ? 'Balance due from customer' : 'Refund to customer' %></span><span class="amount"><%= money(Math.abs(rental.balance_due)) %></span></div>
    <% } else { %>
      <div class="line"><span>Rental charge (<%= quote.days %> × <%= money(rental.daily_rate) %>)</span><span><%= money(quote.baseCharge) %></span></div>
      <% if (rental.discount > 0) { %><div class="line"><span>Discount</span><span>-<%= money(rental.discount) %></span></div><% } %>
      <div class="line total"><span>Contract total</span><span class="amount"><%= money(quote.total) %></span></div>
      <div class="line"><span>Deposit held</span><span><%= money(rental.deposit) %></span></div>
    <% } %>
  </div>

  <% if (rental.return_notes) { %><p class="small muted" style="margin-top:12px"><strong>Return notes:</strong> <%= rental.return_notes %></p><% } %>
</div>

<% if (rental.status === 'active') { %>
<div class="actions" style="margin-top:16px">
  <% if (!rental.handover_signed_at) { %>
  <form method="post" action="/rentals/<%= rental.id %>/sign">
    <input type="hidden" name="_csrf" value="<%= csrfToken %>">
    <button class="btn" type="submit">Mark handover as signed</button>
  </form>
  <% } %>
  <form method="post" action="/rentals/<%= rental.id %>/cancel" onsubmit="return confirm('Cancel this contract and release the car?')">
    <input type="hidden" name="_csrf" value="<%= csrfToken %>">
    <button class="btn danger" type="submit">Cancel contract</button>
  </form>
</div>
<% } %>
<%- include('../partials/foot') %>
