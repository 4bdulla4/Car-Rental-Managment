<%
  // Both states are in the page; the stylesheet shows the one that matches
  // data-theme, so switching is a change of one attribute, not a page load.
  var short = typeof compact !== 'undefined' && compact;
%>
<form method="post" action="/theme" data-theme-toggle>
  <input type="hidden" name="_csrf" value="<%= csrfToken %>">
  <input type="hidden" name="next" value="<%= typeof next === 'undefined' ? path : next %>">
  <input type="hidden" name="theme" value="<%= theme === 'light' ? 'dark' : 'light' %>">
  <button class="theme-toggle" type="submit" aria-label="Switch between light and dark">
    <span class="to-light">
      <svg viewBox="0 0 24 24" aria-hidden="true"><circle cx="12" cy="12" r="4"/><path d="M12 2.5v2M12 19.5v2M2.5 12h2M19.5 12h2M5.2 5.2l1.4 1.4M17.4 17.4l1.4 1.4M18.8 5.2l-1.4 1.4M6.6 17.4l-1.4 1.4"/></svg>
      <span><%= short ? 'Light' : 'Light mode' %></span>
    </span>
    <span class="to-dark">
      <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M20 14.5A8.5 8.5 0 0 1 9.5 4a8.5 8.5 0 1 0 10.5 10.5z"/></svg>
      <span><%= short ? 'Dark' : 'Dark mode' %></span>
    </span>
  </button>
</form>
