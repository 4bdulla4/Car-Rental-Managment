<div class="shell">
  <div class="scrim" data-close-nav></div>

  <aside class="sidebar" id="sidebar">
    <a class="side-brand" href="/">
      <%- include('logo', { size: 30 }) %>
      <span class="wordmark"><%= company.name %><small>fleet &amp; contracts</small></span>
    </a>

    <nav class="side-nav">
      <p class="side-label">Overview</p>
      <a href="/" class="<%= path === '/' ? 'active' : '' %>">
        <svg viewBox="0 0 24 24" aria-hidden="true"><rect x="3" y="3" width="7.5" height="7.5" rx="2"/><rect x="13.5" y="3" width="7.5" height="7.5" rx="2"/><rect x="3" y="13.5" width="7.5" height="7.5" rx="2"/><rect x="13.5" y="13.5" width="7.5" height="7.5" rx="2"/></svg>
        <span>Dashboard</span>
      </a>

      <p class="side-label">Operations</p>
      <a href="/rentals" class="<%= path.startsWith('/rentals') ? 'active' : '' %>">
        <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M14 3H7a2 2 0 0 0-2 2v14a2 2 0 0 0 2 2h10a2 2 0 0 0 2-2V8z"/><path d="M14 3v5h5"/><path d="M9 13h6M9 17h4"/></svg>
        <span>Rentals</span>
      </a>
      <a href="/cars" class="<%= path.startsWith('/cars') ? 'active' : '' %>">
        <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M4 14.5a2.6 2.6 0 0 1 2-2.5l2.4-.5 2-2.8A3.4 3.4 0 0 1 13.1 7h2.8a3.4 3.4 0 0 1 2.8 1.5l1.6 2.4.8.2a2.6 2.6 0 0 1 1.9 2.5v1.6a1 1 0 0 1-1 1h-1.7M4 14.5V16a1 1 0 0 0 1 1h1.3M4 14.5h16"/><circle cx="8.2" cy="16.8" r="2.2"/><circle cx="16.8" cy="16.8" r="2.2"/></svg>
        <span>Fleet</span>
      </a>
      <a href="/customers" class="<%= path.startsWith('/customers') ? 'active' : '' %>">
        <svg viewBox="0 0 24 24" aria-hidden="true"><circle cx="9.5" cy="8" r="3.4"/><path d="M3 19.5c0-3.4 2.9-5.8 6.5-5.8s6.5 2.4 6.5 5.8"/><path d="M16.5 8.4a2.9 2.9 0 0 1 0 5.2"/><path d="M18.4 19.5c0-2.1-.6-3.6-1.7-4.6"/></svg>
        <span>Customers</span>
      </a>

      <% if (currentUser && currentUser.role === 'admin') { %>
        <p class="side-label">Admin</p>
        <a href="/users" class="<%= path.startsWith('/users') ? 'active' : '' %>">
          <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M12 3l7 2.8v5.4c0 4.2-2.9 8-7 9.3-4.1-1.3-7-5.1-7-9.3V5.8z"/><path d="M9.3 12.1l1.9 1.9 3.5-3.7"/></svg>
          <span>Users</span>
        </a>
        <a href="/settings" class="<%= path.startsWith('/settings') ? 'active' : '' %>">
          <svg viewBox="0 0 24 24" aria-hidden="true"><circle cx="12" cy="12" r="3.2"/><path d="M19.4 14.5a1.7 1.7 0 0 0 .3 1.9l.1.1a2 2 0 1 1-2.8 2.8l-.1-.1a1.7 1.7 0 0 0-1.9-.3 1.7 1.7 0 0 0-1 1.5v.2a2 2 0 1 1-4 0v-.1a1.7 1.7 0 0 0-1.1-1.5 1.7 1.7 0 0 0-1.9.3l-.1.1a2 2 0 1 1-2.8-2.8l.1-.1a1.7 1.7 0 0 0 .3-1.9 1.7 1.7 0 0 0-1.5-1H3a2 2 0 1 1 0-4h.1a1.7 1.7 0 0 0 1.5-1.1 1.7 1.7 0 0 0-.3-1.9l-.1-.1a2 2 0 1 1 2.8-2.8l.1.1a1.7 1.7 0 0 0 1.9.3H10a1.7 1.7 0 0 0 1-1.5V3a2 2 0 1 1 4 0v.1a1.7 1.7 0 0 0 1 1.5 1.7 1.7 0 0 0 1.9-.3l.1-.1a2 2 0 1 1 2.8 2.8l-.1.1a1.7 1.7 0 0 0-.3 1.9V10a1.7 1.7 0 0 0 1.5 1h.2a2 2 0 1 1 0 4h-.1a1.7 1.7 0 0 0-1.5 1z"/></svg>
          <span>Settings</span>
        </a>
      <% } %>
    </nav>

    <div class="side-foot">
      <form method="post" action="/theme">
        <input type="hidden" name="_csrf" value="<%= csrfToken %>">
        <input type="hidden" name="next" value="<%= path %>">
        <input type="hidden" name="theme" value="<%= theme === 'light' ? 'dark' : 'light' %>">
        <button class="theme-toggle" type="submit">
          <% if (theme === 'light') { %>
            <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M20 14.5A8.5 8.5 0 0 1 9.5 4a8.5 8.5 0 1 0 10.5 10.5z"/></svg>
            <span>Dark mode</span>
          <% } else { %>
            <svg viewBox="0 0 24 24" aria-hidden="true"><circle cx="12" cy="12" r="4"/><path d="M12 2.5v2M12 19.5v2M2.5 12h2M19.5 12h2M5.2 5.2l1.4 1.4M17.4 17.4l1.4 1.4M18.8 5.2l-1.4 1.4M6.6 17.4l-1.4 1.4"/></svg>
            <span>Light mode</span>
          <% } %>
        </button>
      </form>

      <a class="side-cta" href="/rentals/new">
        <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M12 5v14M5 12h14"/></svg>
        <span>New rental</span>
      </a>
      <div class="side-user">
        <a class="side-user-link" href="/account" title="My account">
          <span class="avatar"><%= currentUser.name.trim().charAt(0).toUpperCase() %></span>
          <span class="side-user-text">
            <strong><%= currentUser.name %></strong>
            <small><%= currentUser.role %></small>
          </span>
        </a>
        <form method="post" action="/logout">
          <input type="hidden" name="_csrf" value="<%= csrfToken %>">
          <button class="icon-btn" type="submit" title="Sign out" aria-label="Sign out">
            <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M15 17l5-5-5-5M20 12H9M11 4H6a2 2 0 0 0-2 2v12a2 2 0 0 0 2 2h5"/></svg>
          </button>
        </form>
      </div>
    </div>
  </aside>

  <div class="content">
    <header class="mobilebar">
      <button class="icon-btn" type="button" data-open-nav aria-label="Open menu">
        <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M4 7h16M4 12h16M4 17h16"/></svg>
      </button>
      <span class="mobile-brand"><%- include('logo', { size: 22 }) %><%= company.name %></span>
    </header>
    <main>
<% if (flash) { %>
<div class="alert <%= flash.type %>">
  <svg viewBox="0 0 24 24" aria-hidden="true"><circle cx="12" cy="12" r="9"/><path d="<%= flash.type === 'success' ? 'M8.5 12.3l2.4 2.4 4.6-4.9' : 'M12 8v5M12 16.2v.1' %>"/></svg>
  <span><%= flash.message %></span>
</div>
<% } %>
