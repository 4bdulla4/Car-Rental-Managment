<!doctype html>
<html lang="en" data-theme="<%= typeof theme === 'undefined' ? 'dark' : theme %>">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<meta name="color-scheme" content="<%= typeof theme === 'undefined' ? 'dark' : theme %>">
<title><%= title %> · <%= company.name %></title>
<link rel="icon" type="image/png" sizes="32x32" href="/img/icon-32.png">
<link rel="apple-touch-icon" sizes="180x180" href="/img/icon-180.png">
<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link href="https://fonts.googleapis.com/css2?family=DM+Sans:wght@400;500;600;700&family=IBM+Plex+Mono:wght@400;500;600&display=swap" rel="stylesheet">
<link rel="stylesheet" href="/css/app.css">
<style>
  /* The light tint is legible on a dark ground; on white the deeper shade is,
     so each theme takes the end of the accent's range that it can carry. */
  :root {
    --accent: <%= theme === 'light' ? accent.deep : accent.base %>;
    --accent-lit: <%= theme === 'light' ? accent.deep : accent.lit %>;
    --accent-soft: rgba(<%= theme === 'light' ? accent.deepRgb : accent.rgb %>, <%= theme === 'light' ? '0.10' : '0.14' %>);
    --accent-rgb: <%= theme === 'light' ? accent.deepRgb : accent.rgb %>;
    --accent-from: <%= accent.from %>;
    --accent-to: <%= accent.to %>;
  }
</style>
</head>
<body>
