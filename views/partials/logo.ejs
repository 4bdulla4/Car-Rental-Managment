<%
  /**
   * The Vida Miami mark, in three cuts:
   *   badge   ring and car, no lettering — for small places, where the name
   *           would only smudge
   *   emblem  the complete roundel, name included
   *   stack   car and name without the ring, for a space wider than it is tall
   *
   * The artwork is white on transparency, so it carries no background of its
   * own. A light page inverts it to ink in the stylesheet. Paper and email get
   * the black cut as a file instead: a printer or a mail client that drops the
   * filter would otherwise print the mark as nothing at all.
   */
  var cut = (typeof variant === 'undefined') ? 'badge' : variant;
  var ratio = { badge: 0.992, emblem: 0.992, stack: 2.205 }[cut] || 1;
  var h = (typeof size === 'undefined') ? 32 : size;
  var forPaper = (typeof ink !== 'undefined') && ink;
%>
<img class="logo-mark<%= forPaper ? ' ink' : '' %>" src="/img/logo-<%= cut %><%= forPaper ? '-ink' : '' %>.png"
     width="<%= Math.round(h * ratio) %>" height="<%= h %>" alt="" aria-hidden="true">
