<%- include('../partials/head') %>
<%- include('../partials/nav') %>

<div class="page-head">
  <div>
    <h1>Settings</h1>
    <p class="sub">Options that apply across <%= company.name %>.</p>
  </div>
</div>
<%- include('../partials/errors') %>

<div class="grid users-grid">
  <div class="card">
    <h3>Company</h3>
    <p class="small muted" style="margin:-8px 0 16px">
      Printed in the header of every handover contract and return sheet.
    </p>
    <form method="post" action="/settings/company">
      <input type="hidden" name="_csrf" value="<%= csrfToken %>">
      <div class="field">
        <label for="company_name">Company name *</label>
        <input id="company_name" name="company_name" value="<%= details.name %>" maxlength="80" required>
      </div>
      <div class="field">
        <label for="company_address">Address</label>
        <input id="company_address" name="company_address" value="<%= details.address %>" maxlength="160"
               placeholder="Street, district, city">
      </div>
      <div class="row">
        <div class="field">
          <label for="company_phone">Phone</label>
          <input id="company_phone" name="company_phone" value="<%= details.phone %>" maxlength="40">
        </div>
        <div class="field">
          <label for="company_email">Email</label>
          <input id="company_email" name="company_email" type="email" value="<%= details.email %>" maxlength="120">
        </div>
        <div class="field">
          <label for="company_reg_no">Registration no.</label>
          <input id="company_reg_no" name="company_reg_no" value="<%= details.regNo %>" maxlength="40">
          <div class="hint">Printed after "CR" on contracts.</div>
        </div>
      </div>
      <button class="btn primary" type="submit">Save company details</button>
    </form>

    <h3 style="margin-top:24px">Contract header preview</h3>
    <div class="doc-preview">
      <strong id="pv-name"><%= details.name %></strong>
      <span id="pv-address"><%= details.address || '—' %></span>
      <span id="pv-contact"></span>
    </div>
  </div>

  <div class="card">
    <h3>Currency</h3>
    <form method="post" action="/settings/currency">
      <input type="hidden" name="_csrf" value="<%= csrfToken %>">
      <div class="field">
        <label for="currency">Currency code</label>
        <input id="currency" name="currency" list="currency-codes" value="<%= currency %>"
               maxlength="5" pattern="[A-Za-z]{2,5}" required autocomplete="off"
               oninput="document.getElementById('preview').textContent =
                        '1,234.50 ' + (this.value.toUpperCase() || '<%= currency %>')">
        <datalist id="currency-codes">
          <% common.forEach(function (c) { %><option value="<%= c[0] %>"><%= c[1] %></option><% }); %>
        </datalist>
        <div class="hint">Pick from the list or type any 2–5 letter code.</div>
      </div>
      <div class="field">
        <label>Preview</label>
        <div class="preview-box mono" id="preview">1,234.50 <%= currency %></div>
        <div class="hint">Amounts always show two decimal places.</div>
      </div>
      <button class="btn primary" type="submit">Save currency</button>
    </form>

    <p class="small muted" style="margin-top:18px">
      Applies to new rentals. Contracts already issued keep the currency they were
      written in, so a list can show more than one code.
    </p>

    <% if (inUse.length) { %>
      <h3 style="margin-top:20px">In use on contracts</h3>
      <div class="lines">
        <% inUse.forEach(function (row) { %>
          <div class="line"><span><%= row.currency || '—' %></span><span><%= row.n %></span></div>
        <% }); %>
      </div>
    <% } %>
  </div>
</div>

<div class="grid cols-2">
<div class="card">
  <h3>Return charges</h3>
  <p class="small muted" style="margin:-8px 0 16px">
    Applied automatically when a car is checked back in, and printed as terms on the
    handover contract.
  </p>
  <form method="post" action="/settings/policy">
    <input type="hidden" name="_csrf" value="<%= csrfToken %>">
    <div class="row">
      <div class="field">
        <label for="fuel_charge_per_eighth">Fuel charge per 1/8 tank (<%= currency %>)</label>
        <input id="fuel_charge_per_eighth" name="fuel_charge_per_eighth" type="number"
               step="0.01" min="0" max="10000" value="<%= policy.fuelChargePerEighth %>" required>
        <div class="hint">A car returned 3/8 down is charged three times this.</div>
      </div>
      <div class="field">
        <label for="late_day_multiplier">Late day multiplier</label>
        <input id="late_day_multiplier" name="late_day_multiplier" type="number"
               step="0.05" min="0" max="10" value="<%= policy.lateDayMultiplier %>" required>
        <div class="hint">Each day past the end date bills at the daily rate times this.</div>
      </div>
    </div>

    <div class="field">
      <label>Worked example</label>
      <div class="lines" id="policy-example">
        <div class="line"><span>2 days late on a <%= money(150) %>/day car</span><span data-p="late"></span></div>
        <div class="line"><span>Returned 3/8 of a tank down</span><span data-p="fuel"></span></div>
        <div class="line total"><span>Added at check-in</span><span class="amount" data-p="total"></span></div>
      </div>
    </div>
    <button class="btn primary" type="submit">Save return charges</button>
  </form>
</div>

<div class="card">
  <h3>Mileage defaults</h3>
  <p class="small muted" style="margin:-8px 0 16px">
    Used when you add a car. Each car can then be tuned individually, and each rental
    keeps the terms it was issued with.
  </p>
  <form method="post" action="/settings/mileage">
    <input type="hidden" name="_csrf" value="<%= csrfToken %>">
    <div class="row">
      <div class="field">
        <label for="km_allowance_per_day">Km included per day</label>
        <input id="km_allowance_per_day" name="km_allowance_per_day" type="number"
               step="1" min="0" max="10000" value="<%= mileage.kmAllowancePerDay %>" required>
        <div class="hint">0 means unlimited mileage.</div>
      </div>
      <div class="field">
        <label for="excess_km_rate">Excess km rate (<%= currency %>)</label>
        <input id="excess_km_rate" name="excess_km_rate" type="number"
               step="0.01" min="0" max="1000" value="<%= mileage.excessKmRate %>" required>
        <div class="hint">Charged per km beyond the allowance.</div>
      </div>
    </div>

    <div class="field">
      <label>Worked example</label>
      <div class="lines">
        <div class="line"><span>A 5-day rental includes</span><span data-m="included"></span></div>
        <div class="line"><span>Driven 1,800 km, so over by</span><span data-m="over"></span></div>
        <div class="line total"><span>Excess charge</span><span class="amount" data-m="fee"></span></div>
      </div>
    </div>

    <label class="check">
      <input type="checkbox" name="apply_to_fleet" value="1">
      <span>Also apply to all <%= carCount %> existing car<%= carCount === 1 ? '' : 's' %></span>
    </label>
    <div class="hint" style="margin-bottom:14px">
      Leave unticked to change only cars added from now on. Contracts already issued are
      never changed either way.
    </div>

    <button class="btn primary" type="submit">Save mileage defaults</button>
  </form>
</div>

<div class="card">
  <h3>Deposit</h3>
  <p class="small muted" style="margin:-8px 0 16px">
    Pre-filled on a new rental. Staff can still change it on any individual contract.
  </p>
  <form method="post" action="/settings/deposit">
    <input type="hidden" name="_csrf" value="<%= csrfToken %>">
    <div class="field">
      <label for="default_deposit">Default deposit (<%= currency %>)</label>
      <input id="default_deposit" name="default_deposit" type="number"
             step="0.01" min="0" max="1000000" value="<%= deposit %>" required>
      <div class="hint">Set 0 if you do not normally take a deposit.</div>
    </div>

    <div class="field">
      <label>Worked example</label>
      <div class="lines">
        <div class="line"><span>5-day rental at <%= money(150) %>/day</span><span><%= money(750) %></span></div>
        <div class="line"><span>Deposit taken at handover</span><span data-d="held"></span></div>
        <div class="line total"><span>Payable at handover</span><span class="amount" data-d="due"></span></div>
      </div>
      <div class="hint">
        The deposit is held, then offset against the final settlement when the car
        comes back. A deposit larger than the total is refunded.
      </div>
    </div>

    <button class="btn primary" type="submit">Save deposit</button>
  </form>
</div>
</div>

<script>
  // Worked example, so the effect of a rate change is visible before saving.
  (function () {
    var f = document.querySelector('form[action="/settings/policy"]');
    var currency = <%- JSON.stringify(currency) %>;
    var fmt = function (n) {
      return (Math.round(n * 100) / 100).toFixed(2).replace(/\B(?=(\d{3})+(?!\d))/, '') + ' ' + currency;
    };
    var paint = function () {
      var late = 2 * 150 * (Number(f.late_day_multiplier.value) || 0);
      var fuel = 3 * (Number(f.fuel_charge_per_eighth.value) || 0);
      f.querySelector('[data-p="late"]').textContent = fmt(late);
      f.querySelector('[data-p="fuel"]').textContent = fmt(fuel);
      f.querySelector('[data-p="total"]').textContent = fmt(late + fuel);
    };
    f.fuel_charge_per_eighth.addEventListener('input', paint);
    f.late_day_multiplier.addEventListener('input', paint);
    paint();
  })();
</script>

<script>
  // Worked example for the deposit.
  (function () {
    var f = document.querySelector('form[action="/settings/deposit"]');
    var currency = <%- JSON.stringify(currency) %>;
    var money = function (n) {
      var fixed = Math.abs(Math.round(n * 100) / 100).toFixed(2).split('.');
      var whole = fixed[0].replace(/\B(?=(\d{3})+(?!\d))/g, ',');
      return (n < 0 ? '-' : '') + whole + '.' + fixed[1] + ' ' + currency;
    };
    var paint = function () {
      var held = Number(f.default_deposit.value) || 0;
      f.querySelector('[data-d="held"]').textContent = money(held);
      f.querySelector('[data-d="due"]').textContent = money(750 - held);
    };
    f.default_deposit.addEventListener('input', paint);
    paint();
  })();
</script>

<script>
  // Worked example for the mileage terms.
  (function () {
    var f = document.querySelector('form[action="/settings/mileage"]');
    var currency = <%- JSON.stringify(currency) %>;
    var money = function (n) { return (Math.round(n * 100) / 100).toFixed(2) + ' ' + currency; };
    var km = function (n) { return n.toLocaleString('en-US') + ' km'; };
    var paint = function () {
      var perDay = Number(f.km_allowance_per_day.value) || 0;
      var rate = Number(f.excess_km_rate.value) || 0;
      var included = perDay * 5;
      var over = perDay === 0 ? 0 : Math.max(0, 1800 - included);
      f.querySelector('[data-m="included"]').textContent = perDay === 0 ? 'Unlimited' : km(included);
      f.querySelector('[data-m="over"]').textContent = perDay === 0 ? '0 km' : km(over);
      f.querySelector('[data-m="fee"]').textContent = money(over * rate);
    };
    f.km_allowance_per_day.addEventListener('input', paint);
    f.excess_km_rate.addEventListener('input', paint);
    paint();
  })();
</script>

<script>
  // Live preview of the contract header as the details are typed.
  (function () {
    var f = document.querySelector('form[action="/settings/company"]');
    var name = document.getElementById('pv-name');
    var address = document.getElementById('pv-address');
    var contact = document.getElementById('pv-contact');
    var paint = function () {
      name.textContent = f.company_name.value.trim() || 'Company name';
      address.textContent = f.company_address.value.trim() || '—';
      var bits = [f.company_phone.value.trim(), f.company_email.value.trim()];
      var reg = f.company_reg_no.value.trim();
      if (reg) bits.push('CR ' + reg);
      contact.textContent = bits.filter(Boolean).join(' · ');
    };
    ['company_name', 'company_address', 'company_phone', 'company_email', 'company_reg_no']
      .forEach(function (n) { f[n].addEventListener('input', paint); });
    paint();
  })();
</script>
<%- include('../partials/foot') %>
