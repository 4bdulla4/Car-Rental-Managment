<%- include('../partials/head') %>
<%- include('../partials/nav') %>

<div class="page-head">
  <div>
    <h1>Settings</h1>
    <p class="sub">Options that apply across <%= company.name %>.</p>
  </div>
</div>
<%- include('../partials/errors') %>

<% var active = ['company','contract','currency','pricing','charges','data'].includes(tab) ? tab : 'company'; %>
<nav class="tabs" role="tablist">
  <a href="/settings?tab=company" data-tab="company" role="tab"
     class="<%= active === 'company' ? 'active' : '' %>"
     aria-selected="<%= active === 'company' ? 'true' : 'false' %>">Company</a>
  <a href="/settings?tab=contract" data-tab="contract" role="tab"
     class="<%= active === 'contract' ? 'active' : '' %>"
     aria-selected="<%= active === 'contract' ? 'true' : 'false' %>">Contract</a>
  <a href="/settings?tab=currency" data-tab="currency" role="tab"
     class="<%= active === 'currency' ? 'active' : '' %>"
     aria-selected="<%= active === 'currency' ? 'true' : 'false' %>">Currency</a>
  <a href="/settings?tab=pricing" data-tab="pricing" role="tab"
     class="<%= active === 'pricing' ? 'active' : '' %>"
     aria-selected="<%= active === 'pricing' ? 'true' : 'false' %>">Pricing</a>
  <a href="/settings?tab=charges" data-tab="charges" role="tab"
     class="<%= active === 'charges' ? 'active' : '' %>"
     aria-selected="<%= active === 'charges' ? 'true' : 'false' %>">Charges</a>
  <a href="/settings?tab=data" data-tab="data" role="tab"
     class="<%= active === 'data' ? 'active' : '' %>"
     aria-selected="<%= active === 'data' ? 'true' : 'false' %>">Sample data</a>
</nav>

<section data-panel="company" <%= active === 'company' ? '' : 'hidden' %>>
<div class="grid cols-2">
  <div class="card">
    <h3>Company</h3>
    <p class="small muted" style="margin:-8px 0 16px">
      Printed in the header of every handover contract and return sheet.
    </p>
    <form method="post" action="/settings/company">
      <input type="hidden" name="_csrf" value="<%= csrfToken %>">
      <div class="field">
        <label for="company_name">Company name *</label>
        <input id="company_name" name="company_name" value="<%= details.name %>" maxlength="80" required>
      </div>
      <div class="field">
        <label for="company_address">Address</label>
        <input id="company_address" name="company_address" value="<%= details.address %>" maxlength="160"
               placeholder="Street, district, city">
      </div>
      <div class="row">
        <div class="field">
          <label for="company_phone">Phone</label>
          <input id="company_phone" name="company_phone" value="<%= details.phone %>" maxlength="40">
        </div>
        <div class="field">
          <label for="company_email">Email</label>
          <input id="company_email" name="company_email" type="email" value="<%= details.email %>" maxlength="120">
        </div>
        <div class="field">
          <label for="company_website">Website</label>
          <input id="company_website" name="company_website" value="<%= details.website %>"
                 maxlength="120" placeholder="example.com">
        </div>
      </div>
      <div class="row">
        <div class="field">
          <label for="company_reg_no">Registration no.</label>
          <input id="company_reg_no" name="company_reg_no" value="<%= details.regNo %>" maxlength="40">
          <div class="hint">Printed after "CR" on contracts.</div>
        </div>
        <div class="field">
          <label for="company_vat_no">VAT number</label>
          <input id="company_vat_no" name="company_vat_no" value="<%= details.vatNo %>" maxlength="40">
          <div class="hint">Shown on contracts when set.</div>
        </div>
        <div class="field">
          <label for="company_bank">Bank or IBAN</label>
          <input id="company_bank" name="company_bank" value="<%= details.bank %>"
                 maxlength="120" placeholder="SA00 0000 0000 0000 0000 0000">
          <div class="hint">Printed so a customer can settle a balance.</div>
        </div>
      </div>
      <div class="field">
        <label for="company_footer">Contract footer note</label>
        <input id="company_footer" name="company_footer" value="<%= details.footer %>" maxlength="200"
               placeholder="Thank you for choosing us — drive safely.">
        <div class="hint">One line at the bottom of every contract. Optional.</div>
      </div>
      <button class="btn primary" type="submit">Save company details</button>
    </form>

    <h3 style="margin-top:24px">Accent colour</h3>
    <p class="small muted" style="margin:-8px 0 14px">
      Used for buttons, links, highlights and the logo. The printed contracts keep their
      own styling.
    </p>
    <form method="post" action="/settings/appearance">
      <input type="hidden" name="_csrf" value="<%= csrfToken %>">
      <div class="swatches">
        <% accents.forEach(function (a) { %>
          <button class="swatch <%= accentKey === a.key ? 'picked' : '' %>" type="submit"
                  name="accent" value="<%= a.key %>" title="<%= a.name %>"
                  style="--sw-from: <%= a.from %>; --sw-to: <%= a.to %>">
            <span class="dot"></span>
            <span><%= a.name %></span>
          </button>
        <% }); %>
      </div>
    </form>

    <h3 style="margin-top:24px">Contract header preview</h3>
    <div class="doc-preview">
      <strong id="pv-name"><%= details.name %></strong>
      <span id="pv-address"><%= details.address || '—' %></span>
      <span id="pv-contact"></span>
    </div>
  </div>
</div>
</section>

<section data-panel="contract" <%= active === 'contract' ? '' : 'hidden' %>>
<div class="grid cols-2">
  <div class="card">
    <h3>Agreement details</h3>
    <p class="small muted" style="margin:-8px 0 16px">
      The parts of the agreement that read the same on every contract. Each is printed
      only when set.
    </p>
    <form method="post" action="/settings/agreement">
      <input type="hidden" name="_csrf" value="<%= csrfToken %>">
      <div class="field">
        <label for="return_location">Return location</label>
        <input id="return_location" name="return_location" value="<%= agreement.returnLocation %>"
               maxlength="160" placeholder="Where a car must be brought back">
        <div class="hint">Pre-filled on every new rental, and changeable per contract.</div>
      </div>
      <div class="field">
        <label for="default_deductible">Insurance excess (<%= currency %>)</label>
        <input id="default_deductible" name="default_deductible" type="number" step="0.01" min="0"
               value="<%= agreement.deductible %>">
        <div class="hint">The renter's liability on a damage claim.</div>
      </div>
      <div class="field">
        <label for="governing_law">Governing law</label>
        <input id="governing_law" name="governing_law" value="<%= agreement.governingLaw %>"
               maxlength="120" placeholder="the Kingdom of Saudi Arabia">
        <div class="hint">Printed as its own clause when set.</div>
      </div>
      <button class="btn primary" type="submit">Save agreement details</button>
    </form>
  </div>

  <div class="card">
    <h3>Contract terms</h3>
    <p class="small muted" style="margin:-8px 0 16px">
      The numbered clauses printed on every handover contract. One per line. Leave it
      blank to use the standard set below. Write <span class="mono">{company}</span>
      where your company name should appear.
    </p>
    <form method="post" action="/settings/terms">
      <input type="hidden" name="_csrf" value="<%= csrfToken %>">
      <div class="field">
        <label for="company_terms">Clauses</label>
        <textarea id="company_terms" name="company_terms" rows="12"
                  placeholder="<%= defaultTerms.join('\n') %>"><%= termsText %></textarea>
        <div class="hint">
          <span data-terms-count></span> · contracts already issued keep the terms they
          were printed with.
        </div>
      </div>
      <div class="actions">
        <button class="btn primary" type="submit">Save terms</button>
        <button class="btn" type="button" data-load-default>Load the standard terms</button>
      </div>
    </form>
  </div>

  <div class="card">
    <h3>Electronic signing</h3>
    <p class="small muted" style="margin:-8px 0 16px">
      How a signing link behaves once it leaves the branch.
    </p>
    <form method="post" action="/settings/signing">
      <input type="hidden" name="_csrf" value="<%= csrfToken %>">

      <label class="check">
        <input type="checkbox" name="sign_code_required" value="1" <%= signing.codeRequired ? 'checked' : '' %>>
        <span>Ask the customer for an access code before they can sign</span>
      </label>
      <div class="hint" style="margin-bottom:6px">
        A six-digit code is issued with every link and shown on the rental page for you to
        read out. It is deliberately left out of the email: a link and a code in the same
        message prove the same single thing — that somebody reached the mailbox. Turning
        this off makes signing quicker and the evidence thinner.
      </div>

      <label class="check" style="margin-top:16px">
        <input type="checkbox" name="licence_required" value="1" <%= signing.licenceRequired ? 'checked' : '' %>>
        <span>Ask for a photo of both sides of the driving licence</span>
      </label>
      <div class="hint" style="margin-bottom:6px">
        The customer photographs the licence on their phone before signing, and both
        sides are printed on the agreement and kept with it. The renter holding a valid
        licence is what the whole contract turns on, so it is worth the evidence rather
        than a tick-box claim.
      </div>

      <div class="field" style="margin-top:18px">
        <label for="sign_link_days">A signing link lasts (days)</label>
        <input id="sign_link_days" name="sign_link_days" type="number" min="1" max="90" step="1"
               value="<%= signing.linkDays %>" required>
        <div class="hint">
          After that the link stops working and you issue a new one. A link that never
          expires is a link that can still be signed a year after the car came back.
        </div>
      </div>

      <button class="btn primary" type="submit">Save signing rules</button>
    </form>
  </div>
</div>
</section>

<section data-panel="currency" <%= active === 'currency' ? '' : 'hidden' %>>
<div class="panel-single">
  <div class="card">
    <h3>Currency</h3>
    <form method="post" action="/settings/currency">
      <input type="hidden" name="_csrf" value="<%= csrfToken %>">
      <div class="field">
        <label for="currency">Currency code</label>
        <input id="currency" name="currency" list="currency-codes" value="<%= currency %>"
               maxlength="5" pattern="[A-Za-z]{2,5}" required autocomplete="off"
               oninput="document.getElementById('preview').textContent =
                        '1,234.50 ' + (this.value.toUpperCase() || '<%= currency %>')">
        <datalist id="currency-codes">
          <% common.forEach(function (c) { %><option value="<%= c[0] %>"><%= c[1] %></option><% }); %>
        </datalist>
        <div class="hint">Pick from the list or type any 2–5 letter code.</div>
      </div>
      <div class="field">
        <label>Preview</label>
        <div class="preview-box mono" id="preview">1,234.50 <%= currency %></div>
        <div class="hint">Amounts always show two decimal places.</div>
      </div>
      <label class="check">
        <input type="checkbox" name="relabel" value="1">
        <span>Also relabel existing contracts to the new currency</span>
      </label>
      <div class="hint" style="margin-bottom:14px">
        Tick this if the old code was a setup mistake, so reports read in one currency.
        Leave it unticked if those contracts were genuinely priced in the old currency —
        relabelling changes the code only, never the amounts.
      </div>

      <button class="btn primary" type="submit">Save currency</button>
    </form>

    <p class="small muted" style="margin-top:18px">
      Applies to new rentals. Contracts already issued keep the currency they were
      written in, so a list can show more than one code.
    </p>

    <% if (inUse.length) { %>
      <h3 style="margin-top:20px">In use on contracts</h3>
      <div class="lines">
        <% inUse.forEach(function (row) { %>
          <div class="line">
            <span>
              <%= row.currency || '—' %>
              <% if (row.currency === currency) { %><span class="tag">Current</span><% } %>
            </span>
            <span><%= row.n %></span>
          </div>
        <% }); %>
      </div>

      <% var stale = inUse.filter(function (r) { return r.currency && r.currency !== currency; }); %>
      <% if (stale.length) { %>
        <p class="hint" style="margin-top:14px">
          Those contracts keep their own code, so the rentals list and the dashboard
          still show it. That is deliberate — a signed agreement should not change
          meaning. If the old code was simply a setup mistake, relabel it:
        </p>
        <% stale.forEach(function (row) { %>
          <form method="post" action="/settings/currency/relabel" style="margin-top:10px"
                onsubmit="return confirm('Relabel <%= row.n %> contract(s) from <%= row.currency %> to <%= currency %>?\n\nAmounts are NOT converted — only the code changes.')">
            <input type="hidden" name="_csrf" value="<%= csrfToken %>">
            <input type="hidden" name="from" value="<%= row.currency %>">
            <button class="btn sm" type="submit">
              Relabel <%= row.n %> <%= row.currency %> contract<%= row.n === 1 ? '' : 's' %> as <%= currency %>
            </button>
          </form>
        <% }); %>
        <div class="hint" style="margin-top:8px">Amounts are never converted; only the code changes.</div>
      <% } %>
    <% } %>
</div>
</section>

<section data-panel="pricing" <%= active === 'pricing' ? '' : 'hidden' %>>
<div class="grid cols-2">
<div class="card">
  <h3>Daily rate</h3>
  <p class="small muted" style="margin:-8px 0 16px">
    Pre-filled when you add a car. The rate that actually applies lives on each car,
    and is copied onto a rental when it is issued.
  </p>
  <form method="post" action="/settings/daily-rate">
    <input type="hidden" name="_csrf" value="<%= csrfToken %>">
    <div class="field">
      <label for="default_daily_rate">Default daily rate (<%= currency %>)</label>
      <input id="default_daily_rate" name="default_daily_rate" type="number"
             step="0.01" min="0" max="1000000" value="<%= dailyRate %>" required>
      <div class="hint">Set 0 to leave the field blank when adding a car.</div>
    </div>

    <% if (fleetRates && fleetRates.low !== null) { %>
    <div class="field">
      <label>Your fleet today</label>
      <div class="lines">
        <div class="line"><span>Lowest rate</span><span><%= money(fleetRates.low) %></span></div>
        <div class="line"><span>Highest rate</span><span><%= money(fleetRates.high) %></span></div>
      </div>
      <div class="hint">
        Rates differ per car, so this default is only a starting point. Change an
        individual rate on the car's own page under Fleet.
      </div>
    </div>
    <% } %>

    <button class="btn primary" type="submit">Save daily rate</button>
  </form>
</div>
<div class="card">
  <h3>Deposit</h3>
  <p class="small muted" style="margin:-8px 0 16px">
    Pre-filled on a new rental. Staff can still change it on any individual contract.
  </p>
  <form method="post" action="/settings/deposit">
    <input type="hidden" name="_csrf" value="<%= csrfToken %>">
    <div class="field">
      <label for="default_deposit">Default deposit (<%= currency %>)</label>
      <input id="default_deposit" name="default_deposit" type="number"
             step="0.01" min="0" max="1000000" value="<%= deposit %>" required>
      <div class="hint">Set 0 if you do not normally take a deposit.</div>
    </div>

    <div class="field">
      <label>Worked example</label>
      <div class="lines">
        <div class="line"><span>5-day rental at <%= money(150) %>/day</span><span><%= money(750) %></span></div>
        <div class="line"><span>Deposit taken at handover</span><span data-d="held"></span></div>
        <div class="line total"><span>Payable at handover</span><span class="amount" data-d="due"></span></div>
      </div>
      <div class="hint">
        The deposit is held, then offset against the final settlement when the car
        comes back. A deposit larger than the total is refunded.
      </div>
    </div>

    <button class="btn primary" type="submit">Save deposit</button>
  </form>
</div>
<div class="card">
  <h3>Discount</h3>
  <p class="small muted" style="margin:-8px 0 16px">
    A standing discount pre-filled on a new rental. Staff can still change or clear it
    on any individual contract.
  </p>
  <form method="post" action="/settings/discount">
    <input type="hidden" name="_csrf" value="<%= csrfToken %>">
    <div class="field">
      <label for="default_discount_mode">Applied as</label>
      <select id="default_discount_mode" name="default_discount_mode">
        <option value="amount" <%= discount.mode === 'amount' ? 'selected' : '' %>>Fixed amount</option>
        <option value="percent" <%= discount.mode === 'percent' ? 'selected' : '' %>>Percentage of the rental charge</option>
      </select>
    </div>
    <div class="field">
      <label for="default_discount" id="discount-label">Default discount</label>
      <input id="default_discount" name="default_discount" type="number"
             step="0.01" min="0" value="<%= discount.value %>" required>
      <div class="hint">Set 0 for no standing discount.</div>
    </div>

    <div class="field">
      <label>Worked example</label>
      <div class="lines">
        <div class="line"><span>5-day rental at <%= money(150) %>/day</span><span><%= money(750) %></span></div>
        <div class="line"><span>Discount applied</span><span data-x="off"></span></div>
        <div class="line total"><span>Contract total</span><span class="amount" data-x="total"></span></div>
      </div>
      <div class="hint">
        A percentage is worked out against the rental charge when the contract is
        issued; the contract itself always records a fixed amount.
      </div>
    </div>

    <button class="btn primary" type="submit">Save discount</button>
  </form>
</div>
</section>

<section data-panel="charges" <%= active === 'charges' ? '' : 'hidden' %>>
<div class="grid cols-2">
<div class="card">
  <h3>Return charges</h3>
  <p class="small muted" style="margin:-8px 0 16px">
    Applied automatically when a car is checked back in, and printed as terms on the
    handover contract.
  </p>
  <form method="post" action="/settings/policy">
    <input type="hidden" name="_csrf" value="<%= csrfToken %>">
    <div class="row">
      <div class="field">
        <label for="fuel_charge_per_eighth">Fuel charge per 1/8 tank (<%= currency %>)</label>
        <input id="fuel_charge_per_eighth" name="fuel_charge_per_eighth" type="number"
               step="0.01" min="0" max="10000" value="<%= policy.fuelChargePerEighth %>" required>
        <div class="hint">A car returned 3/8 down is charged three times this.</div>
      </div>
      <div class="field">
        <label for="late_day_multiplier">Late day multiplier</label>
        <input id="late_day_multiplier" name="late_day_multiplier" type="number"
               step="0.05" min="0" max="10" value="<%= policy.lateDayMultiplier %>" required>
        <div class="hint">Each day past the end date bills at the daily rate times this.</div>
      </div>
    </div>

    <div class="field">
      <label>Worked example</label>
      <div class="lines" id="policy-example">
        <div class="line"><span>2 days late on a <%= money(150) %>/day car</span><span data-p="late"></span></div>
        <div class="line"><span>Returned 3/8 of a tank down</span><span data-p="fuel"></span></div>
        <div class="line total"><span>Added at check-in</span><span class="amount" data-p="total"></span></div>
      </div>
    </div>
    <button class="btn primary" type="submit">Save return charges</button>
  </form>
</div>
<div class="card">
  <h3>Mileage defaults</h3>
  <p class="small muted" style="margin:-8px 0 16px">
    Used when you add a car. Each car can then be tuned individually, and each rental
    keeps the terms it was issued with.
  </p>
  <form method="post" action="/settings/mileage">
    <input type="hidden" name="_csrf" value="<%= csrfToken %>">
    <div class="row">
      <div class="field">
        <label for="km_allowance_per_day">Km included per day</label>
        <input id="km_allowance_per_day" name="km_allowance_per_day" type="number"
               step="1" min="0" max="10000" value="<%= mileage.kmAllowancePerDay %>" required>
        <div class="hint">0 means unlimited mileage.</div>
      </div>
      <div class="field">
        <label for="excess_km_rate">Excess km rate (<%= currency %>)</label>
        <input id="excess_km_rate" name="excess_km_rate" type="number"
               step="0.01" min="0" max="1000" value="<%= mileage.excessKmRate %>" required>
        <div class="hint">Charged per km beyond the allowance.</div>
      </div>
    </div>

    <div class="field">
      <label>Worked example</label>
      <div class="lines">
        <div class="line"><span>A 5-day rental includes</span><span data-m="included"></span></div>
        <div class="line"><span>Driven 1,800 km, so over by</span><span data-m="over"></span></div>
        <div class="line total"><span>Excess charge</span><span class="amount" data-m="fee"></span></div>
      </div>
    </div>

    <label class="check">
      <input type="checkbox" name="apply_to_fleet" value="1">
      <span>Also apply to all <%= carCount %> existing car<%= carCount === 1 ? '' : 's' %></span>
    </label>
    <div class="hint" style="margin-bottom:14px">
      Leave unticked to change only cars added from now on. Contracts already issued are
      never changed either way.
    </div>

    <button class="btn primary" type="submit">Save mileage defaults</button>
  </form>
</div>
</div>
</section>

<section data-panel="data" <%= active === 'data' ? '' : 'hidden' %>>
<div class="panel-single">
<div class="card">
  <h3>Sample data</h3>
  <p class="small muted" style="margin:-8px 0 16px">
    A made-up year of trading, so the dashboard and the reports have something to
    show before the first real contract is written.
  </p>

  <% if (sample.rentals) { %>
    <div class="alert note" style="margin-bottom:18px">
      <svg viewBox="0 0 24 24" aria-hidden="true"><circle cx="12" cy="12" r="9"/><path d="M12 11v5M12 7.8v.1"/></svg>
      <div>
        <strong>Loaded.</strong>
        <%= sample.rentals %> closed contracts, <%= sample.cars %> cars and
        <%= sample.customers %> customers are marked as sample records. Their plates
        and licence numbers all start with <code>SMP-</code>, so they are easy to tell apart.
      </div>
    </div>
    <form method="post" action="/settings/sample-data/remove">
      <input type="hidden" name="_csrf" value="<%= csrfToken %>">
      <button class="btn danger" type="submit">Remove sample data</button>
    </form>
    <p class="hint">
      Only the flagged records are deleted. Anything you created yourself stays, and a
      sample car or customer that has since been put on a real contract is kept too.
    </p>
  <% } else { %>
    <p class="small muted" style="margin-bottom:16px">
      Loading it creates <%= sampleCars %> cars, <%= sampleCustomers %> customers and around
      thirty closed contracts spread over the last twelve months, priced in
      <%= currency %> at the charges set above. Nothing you already have is changed.
    </p>
    <form method="post" action="/settings/sample-data/load">
      <input type="hidden" name="_csrf" value="<%= csrfToken %>">
      <button class="btn primary" type="submit">Load sample data</button>
    </form>
    <p class="hint">You can remove it again from here at any time.</p>
  <% } %>
</div>
</div>
</section>

<script>
  // Switching is instant; the address bar keeps the tab so a saved form returns here.
  (function () {
    var tabs = document.querySelectorAll('.tabs a[data-tab]');
    var panels = document.querySelectorAll('[data-panel]');
    tabs.forEach(function (tab) {
      tab.addEventListener('click', function (e) {
        e.preventDefault();
        var name = tab.dataset.tab;
        tabs.forEach(function (t) {
          var on = t === tab;
          t.classList.toggle('active', on);
          t.setAttribute('aria-selected', String(on));
        });
        panels.forEach(function (p) { p.hidden = p.dataset.panel !== name; });
        history.replaceState(null, '', '/settings?tab=' + name);
      });
    });
  })();
</script>

<script>
  // Worked example, so the effect of a rate change is visible before saving.
  (function () {
    var f = document.querySelector('form[action="/settings/policy"]');
    var currency = <%- JSON.stringify(currency) %>;
    var fmt = function (n) {
      return (Math.round(n * 100) / 100).toFixed(2).replace(/\B(?=(\d{3})+(?!\d))/, '') + ' ' + currency;
    };
    var paint = function () {
      var late = 2 * 150 * (Number(f.late_day_multiplier.value) || 0);
      var fuel = 3 * (Number(f.fuel_charge_per_eighth.value) || 0);
      f.querySelector('[data-p="late"]').textContent = fmt(late);
      f.querySelector('[data-p="fuel"]').textContent = fmt(fuel);
      f.querySelector('[data-p="total"]').textContent = fmt(late + fuel);
    };
    f.fuel_charge_per_eighth.addEventListener('input', paint);
    f.late_day_multiplier.addEventListener('input', paint);
    paint();
  })();
</script>

<script>
  // Worked example for the discount, in whichever mode is selected.
  (function () {
    var f = document.querySelector('form[action="/settings/discount"]');
    var currency = <%- JSON.stringify(currency) %>;
    var money = function (n) {
      var parts = Math.abs(Math.round(n * 100) / 100).toFixed(2).split('.');
      return (n < 0 ? '-' : '') + parts[0].replace(/\B(?=(\d{3})+(?!\d))/g, ',') + '.' + parts[1] + ' ' + currency;
    };
    var paint = function () {
      var percent = f.default_discount_mode.value === 'percent';
      var raw = Number(f.default_discount.value) || 0;
      var off = percent ? Math.round(750 * raw) / 100 : raw;
      off = Math.min(off, 750);
      document.getElementById('discount-label').textContent =
        percent ? 'Default discount (% of rental charge)' : 'Default discount (' + currency + ')';
      f.default_discount.max = percent ? 100 : 1000000;
      f.querySelector('[data-x="off"]').textContent = (off > 0 ? '-' : '') + money(off);
      f.querySelector('[data-x="total"]').textContent = money(750 - off);
    };
    f.default_discount_mode.addEventListener('change', paint);
    f.default_discount.addEventListener('input', paint);
    paint();
  })();
</script>

<script>
  // Worked example for the deposit.
  (function () {
    var f = document.querySelector('form[action="/settings/deposit"]');
    var currency = <%- JSON.stringify(currency) %>;
    var money = function (n) {
      var fixed = Math.abs(Math.round(n * 100) / 100).toFixed(2).split('.');
      var whole = fixed[0].replace(/\B(?=(\d{3})+(?!\d))/g, ',');
      return (n < 0 ? '-' : '') + whole + '.' + fixed[1] + ' ' + currency;
    };
    var paint = function () {
      var held = Number(f.default_deposit.value) || 0;
      f.querySelector('[data-d="held"]').textContent = money(held);
      f.querySelector('[data-d="due"]').textContent = money(750 - held);
    };
    f.default_deposit.addEventListener('input', paint);
    paint();
  })();
</script>

<script>
  // Worked example for the mileage terms.
  (function () {
    var f = document.querySelector('form[action="/settings/mileage"]');
    var currency = <%- JSON.stringify(currency) %>;
    var money = function (n) { return (Math.round(n * 100) / 100).toFixed(2) + ' ' + currency; };
    var km = function (n) { return n.toLocaleString('en-US') + ' km'; };
    var paint = function () {
      var perDay = Number(f.km_allowance_per_day.value) || 0;
      var rate = Number(f.excess_km_rate.value) || 0;
      var included = perDay * 5;
      var over = perDay === 0 ? 0 : Math.max(0, 1800 - included);
      f.querySelector('[data-m="included"]').textContent = perDay === 0 ? 'Unlimited' : km(included);
      f.querySelector('[data-m="over"]').textContent = perDay === 0 ? '0 km' : km(over);
      f.querySelector('[data-m="fee"]').textContent = money(over * rate);
    };
    f.km_allowance_per_day.addEventListener('input', paint);
    f.excess_km_rate.addEventListener('input', paint);
    paint();
  })();
</script>

<script>
  // Clause count, and a way back to the standard wording.
  (function () {
    var box = document.getElementById('company_terms');
    if (!box) return;
    var count = document.querySelector('[data-terms-count]');
    var DEFAULTS = <%- JSON.stringify(defaultTerms) %>;
    var paint = function () {
      var n = box.value.split('\n').map(function (l) { return l.trim(); }).filter(Boolean).length;
      count.textContent = n ? n + ' clause' + (n === 1 ? '' : 's') : 'Using the standard ' + DEFAULTS.length + ' clauses';
    };
    box.addEventListener('input', paint);
    document.querySelector('[data-load-default]').addEventListener('click', function () {
      box.value = DEFAULTS.join('\n');
      paint();
      box.focus();
    });
    paint();
  })();
</script>

<script>
  // Live preview of the contract header as the details are typed.
  (function () {
    var f = document.querySelector('form[action="/settings/company"]');
    var name = document.getElementById('pv-name');
    var address = document.getElementById('pv-address');
    var contact = document.getElementById('pv-contact');
    var paint = function () {
      name.textContent = f.company_name.value.trim() || 'Company name';
      address.textContent = f.company_address.value.trim() || '—';
      var bits = [f.company_phone.value.trim(), f.company_email.value.trim()];
      var reg = f.company_reg_no.value.trim();
      if (reg) bits.push('CR ' + reg);
      contact.textContent = bits.filter(Boolean).join(' · ');
    };
    ['company_name', 'company_address', 'company_phone', 'company_email', 'company_reg_no']
      .forEach(function (n) { f[n].addEventListener('input', paint); });
    paint();
  })();
</script>
