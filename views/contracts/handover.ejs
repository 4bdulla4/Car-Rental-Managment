<!doctype html>
<html lang="en">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<title><%= rental.contract_no %> · Car rental agreement</title>
<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link href="https://fonts.googleapis.com/css2?family=DM+Sans:wght@400;500;600;700&family=IBM+Plex+Mono:wght@400;500;600&display=swap" rel="stylesheet">
<link rel="stylesheet" href="/css/print.css">
</head>
<body>
<% if (typeof embedded === 'undefined' || !embedded) { %>
<div class="toolbar-print">
  <button onclick="window.print()">Print / Save as PDF</button>
  <a href="/rentals/<%= rental.id %>">Back to contract</a>
  <a href="/rentals">All rentals</a>
</div>
<% } %>

<div class="sheet">
  <header class="doc">
    <div class="co">
      <div class="co-title">
        <%- include('../partials/logo', { size: 44, ink: true }) %>
        <h1><%= company.name %></h1>
      </div>
      <p><%= company.address %></p>
      <p><%= company.phone %><%= company.email ? ' · ' + company.email : '' %><%= company.website ? ' · ' + company.website : '' %></p>
      <p><%= company.regNo ? 'CR ' + company.regNo : '' %><%= company.vatNo ? (company.regNo ? ' · ' : '') + 'VAT ' + company.vatNo : '' %></p>
    </div>
    <div class="meta">
      <div class="type">Car Rental Agreement</div>
      <div class="no"><%= rental.contract_no %></div>
      <div class="date">Made on <%= String(rental.created_at).slice(0, 10) %></div>
    </div>
  </header>

  <p class="preamble">
    This Car Rental Agreement (“Agreement”) is made and entered into as of
    <strong><%= String(rental.created_at).slice(0, 10) %></strong>, by and between
    <strong><%= company.name %></strong> (“Lessor”) and
    <strong><%= rental.full_name %></strong> (“Lessee”).
  </p>

  <h2 class="section">1. Vehicle information</h2>
  <div class="cols">
    <dl class="kv">
      <dt>Make</dt><dd><%= rental.make %></dd>
      <dt>Model</dt><dd><%= rental.model %></dd>
      <dt>Year</dt><dd><%= rental.year || '—' %></dd>
    </dl>
    <dl class="kv">
      <dt>Colour</dt><dd><%= rental.color || '—' %></dd>
      <dt>Plate number</dt><dd class="mono"><%= rental.plate %></dd>
      <dt>VIN</dt><dd class="mono"><%= rental.vin || '—' %></dd>
    </dl>
  </div>

  <h2 class="section">2. Rental period</h2>
  <div class="cols">
    <dl class="kv">
      <dt>Start</dt><dd class="mono"><%= rental.start_date %><%= rental.start_time ? ' at ' + rental.start_time : '' %></dd>
      <dt>End</dt><dd class="mono"><%= rental.end_date %><%= rental.end_time ? ' at ' + rental.end_time : '' %></dd>
    </dl>
    <dl class="kv">
      <dt>Duration</dt><dd><%= quote.days %> day<%= quote.days === 1 ? '' : 's' %></dd>
      <dt>Odometer out</dt><dd class="mono"><%= rental.pickup_odometer.toLocaleString('en-US') %> km</dd>
    </dl>
  </div>

  <h2 class="section">3. Rental rate</h2>
  <p>
    The rental rate shall be <strong><%= money(rental.daily_rate) %> per day</strong>, plus any
    applicable taxes and fees.
  </p>
  <table class="charges">
    <tr><td><%= quote.days %> day<%= quote.days === 1 ? '' : 's' %> × <%= money(rental.daily_rate) %></td><td class="amt"><%= money(quote.baseCharge) %></td></tr>
    <% if (rental.discount > 0) { %><tr><td>Discount</td><td class="amt">-<%= money(rental.discount) %></td></tr><% } %>
    <tr class="total"><td>Agreement total</td><td class="amt"><%= money(quote.total) %></td></tr>
  </table>

  <h2 class="section">4. Security deposit</h2>
  <p>
    The Lessee shall pay a refundable security deposit of <strong><%= money(rental.deposit) %></strong>
    before taking possession of the vehicle. It covers any damage to the vehicle during the
    rental period or other amounts due, and the balance is refunded after inspection.
    Payable at handover: <strong><%= money(quote.balanceDue) %></strong>.
    <% if (company.bank) { %><br>Payment may be made to <%= company.bank %>.<% } %>
  </p>

  <h2 class="section">5. Insurance and deductibles</h2>
  <p>
    The Lessee is responsible for any damage to the vehicle not covered by the insurance
    policy. The deductible for any damage claim shall be
    <strong><%= rental.deductible ? money(rental.deductible) : 'as stated in the insurance policy' %></strong>.
  </p>

  <h2 class="section">6. Condition of vehicle</h2>
  <p>
    The Lessor states that the vehicle is in good condition and free of any known mechanical
    issues, except as disclosed here. The Lessee agrees to return the vehicle in the same
    condition, ordinary wear and tear excepted.
  </p>
  <div class="checklist">
    <span>Spare tyre</span><span>Jack &amp; tools</span><span>First-aid kit</span><span>Warning triangle</span>
    <span>Registration card</span><span>Insurance card</span><span>Floor mats</span><span>Charging cable</span>
  </div>
  <div class="note"><%= rental.pickup_notes || 'No pre-existing damage recorded.' %></div>

  <h2 class="section">7. Fuel policy</h2>
  <p>
    The vehicle is provided at <strong><%= fuelLabel(rental.pickup_fuel) %></strong> and must be
    returned at the same level. If it is not, a refuelling fee of
    <strong><%= money(policy.fuelChargePerEighth) %> per 1/8 of a tank</strong> will be charged.
  </p>

  <h2 class="section">8. Mileage limit</h2>
  <p>
    <% if (rental.km_allowance_per_day) { %>
      The Lessee is allowed <strong><%= rental.km_allowance_per_day %> kilometres per day</strong>
      (<%= (rental.km_allowance_per_day * quote.days).toLocaleString('en-US') %> km over this
      agreement). Additional mileage is charged at
      <strong><%= money(rental.excess_km_rate) %> per kilometre</strong>.
    <% } else { %>
      Mileage is <strong>unlimited</strong> under this agreement.
    <% } %>
  </p>

  <h2 class="section">9. Return of vehicle</h2>
  <p>
    The vehicle shall be returned to
    <strong><%= rental.return_location || company.address || 'the Lessor’s place of business' %></strong>
    on or before the end date and time stated above. Late returns incur an additional fee of
    <strong><%= policy.lateDayMultiplier %>× the daily rate per day</strong>, being
    <strong><%= money(rental.daily_rate * policy.lateDayMultiplier) %> per day</strong>.
  </p>

  <h2 class="section">10. Terms</h2>
  <div class="terms">
    <ol>
      <% terms.forEach(function (clause) { %><li><%= clause %></li><% }); %>
    </ol>
  </div>

  <% if (agreement.governingLaw) { %>
  <h2 class="section">11. Governing law</h2>
  <p>This Agreement shall be governed by the laws of <strong><%= agreement.governingLaw %></strong>.</p>
  <% } %>

  <h2 class="section"><%= agreement.governingLaw ? 12 : 11 %>. Contact details</h2>
  <div class="cols">
    <dl class="kv">
      <dt>Lessee</dt><dd><%= rental.full_name %></dd>
      <dt>Phone</dt><dd class="mono"><%= rental.phone %></dd>
      <dt>ID / passport</dt><dd class="mono"><%= rental.id_number || '—' %></dd>
      <dt>Licence</dt><dd class="mono"><%= rental.license_number || '—' %><%= rental.license_expiry ? ' · exp ' + rental.license_expiry : '' %></dd>
    </dl>
    <dl class="kv">
      <dt>Address</dt><dd><%= rental.address || '—' %></dd>
      <dt>Emergency contact</dt><dd><%= rental.emergency_name || '—' %></dd>
      <dt>Emergency phone</dt><dd class="mono"><%= rental.emergency_phone || '—' %></dd>
      <dt>Lessor phone</dt><dd class="mono"><%= company.phone || '—' %></dd>
    </dl>
  </div>

  <h2 class="section"><%= agreement.governingLaw ? 13 : 12 %>. Signatures</h2>
  <p class="small-print">
    IN WITNESS WHEREOF, the parties have executed this Agreement as of the date first
    written above.
  </p>
  <div class="signatures">
    <div class="sign-box">
      <div class="role">Lessee — <%= rental.full_name %></div>
      <div class="line">
        <% if (rental.signature_data) { %>
          <img class="signature" src="<%= rental.signature_data %>" alt="Signature of <%= rental.signed_name %>">
        <% } %>
      </div>
      <div class="hint">
        <% if (rental.signature_data) { %>
          Signed electronically by <%= rental.signed_name %> on <%= rental.handover_signed_at %> UTC<%= rental.signed_ip ? ' from ' + rental.signed_ip : '' %>
        <% } else { %>
          Signature &amp; date · I accept the terms above
        <% } %>
      </div>
    </div>
    <div class="sign-box">
      <div class="role">Lessor — <%= company.name %><%= rental.issued_by ? ' (' + rental.issued_by + ')' : '' %></div>
      <div class="line"></div>
      <div class="hint">Signature &amp; date</div>
    </div>
  </div>

  <footer class="doc">
    <span><%= rental.contract_no %> · agreement</span>
    <span><%= company.footer || company.name %></span>
  </footer>
</div>
</body>
</html>
