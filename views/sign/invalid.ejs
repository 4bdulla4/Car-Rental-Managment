<!doctype html>
<html lang="en" data-theme="<%= theme %>">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<title><%= title %> · <%= company.name %></title>
<link href="https://fonts.googleapis.com/css2?family=DM+Sans:wght@400;500;600;700&family=IBM+Plex+Mono:wght@400;500;600&display=swap" rel="stylesheet">
<link rel="stylesheet" href="/css/app.css">
<style>:root { --accent: <%= accent.base %>; --accent-lit: <%= accent.lit %>; }</style>
</head>
<body>
<div class="auth"><section class="auth-form" style="grid-column:1/-1">
  <div class="auth-card" style="text-align:center">
    <h2>This link is not valid</h2>
    <p class="sub">
      It may have been mistyped, or the agreement may already have been completed.
      Please ask <%= company.name %> for a new link.
    </p>
    <% if (company.phone) { %><p class="auth-note">Call <%= company.phone %></p><% } %>
  </div>
</section></div>
</body>
</html>
