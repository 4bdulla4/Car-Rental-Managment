<%- include('partials/head') %>
<div class="auth">
  <section class="auth-brand">
    <div class="top">
      <%- include('partials/logo', { size: 38 }) %>
      <span><%= company.name %></span>
    </div>

    <div>
      <h1>Every key handed over, on paper.</h1>
      <p class="lede">
        Track the fleet, issue numbered handover contracts in one click, and settle
        late days, mileage and fuel automatically when the car comes back.
      </p>
      <div class="auth-points">
        <div>
          <svg viewBox="0 0 24 24"><path d="M14 3H7a2 2 0 0 0-2 2v14a2 2 0 0 0 2 2h10a2 2 0 0 0 2-2V8z"/><path d="M14 3v5h5"/><path d="M9 13h6M9 17h4"/></svg>
          <span>Printable A4 handover agreements</span>
        </div>
        <div>
          <svg viewBox="0 0 24 24"><path d="M4 14.5a2.6 2.6 0 0 1 2-2.5l2.4-.5 2-2.8A3.4 3.4 0 0 1 13.1 7h2.8a3.4 3.4 0 0 1 2.8 1.5l1.6 2.4.8.2a2.6 2.6 0 0 1 1.9 2.5v1.6a1 1 0 0 1-1 1h-1.7M4 14.5V16a1 1 0 0 0 1 1h1.3M4 14.5h16"/><circle cx="8.2" cy="16.8" r="2.2"/><circle cx="16.8" cy="16.8" r="2.2"/></svg>
          <span>Live fleet status and overdue returns</span>
        </div>
        <div>
          <svg viewBox="0 0 24 24"><path d="M12 3v18M16.5 7.5H9.8a2.4 2.4 0 0 0 0 4.8h4.4a2.4 2.4 0 0 1 0 4.8H7"/></svg>
          <span>Settlements calculated on check-in</span>
        </div>
      </div>
    </div>

    <p class="auth-foot"><%= company.address %></p>
  </section>

  <section class="auth-form">
    <div class="auth-card">
      <div class="mobile-logo">
        <%- include('partials/logo', { size: 34 }) %>
        <span><%= company.name %></span>
      </div>

      <h2>Sign in</h2>
      <p class="sub">Use your staff account to manage the fleet and contracts.</p>

      <% if (error) { %>
      <div class="alert error">
        <svg viewBox="0 0 24 24"><circle cx="12" cy="12" r="9"/><path d="M12 8v5M12 16.2v.1"/></svg>
        <span><%= error %></span>
      </div>
      <% } %>

      <form method="post" action="/login" autocomplete="on">
        <input type="hidden" name="_csrf" value="<%= csrfToken %>">
        <input type="hidden" name="next" value="<%= next %>">
        <div class="field">
          <label for="email">Email address</label>
          <input id="email" name="email" type="email" value="<%= email %>" placeholder="you@company.com" required autofocus>
        </div>
        <div class="field">
          <label for="password">Password</label>
          <input id="password" name="password" type="password" placeholder="••••••••••" required>
        </div>
        <button class="btn primary" type="submit">
          <span>Sign in</span>
          <svg viewBox="0 0 24 24"><path d="M5 12h13M13 6l6 6-6 6"/></svg>
        </button>
      </form>

      <p class="auth-note">Locked out? Ask an administrator to reset your password.</p>
    </div>
  </section>
</div>
</body>
</html>
